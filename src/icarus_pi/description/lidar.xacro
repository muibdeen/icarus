<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

	<!--lidar intrinsics-->
	<link name="lidar_link">
		<inertial>
			<origin xyz = "0 0 0" rpy="0 0 0"/>
			<mass value=".17"/>
			<inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
		</inertial>

		<collision>
			<origin xyz = "0 0 0"/>
			<geometry>
				<cylinder radius="${lidar_radius}" length=".06"/>
			</geometry>
		</collision>

		<visual>
			<origin xyz = "0 0 0" rpy="0 0 0"/>
			<geometry>
				<cylinder radius="${lidar_radius}" length=".06"/>
			</geometry>
			<material name="black">
				<color rgba="0 0 0 1"/>
			</material>
		</visual>
	</link>

	<!--create the joint that the lidar_link will be bound to with the base being the base_link-->
	<joint name="lidar_joint" type="fixed">
		<parent link="chassis"/>
		<child link="lidar_link"/>
		<origin xyz="${chassis_length-lidar_radius} 0 ${chassis_height + 0.03}" rpy="0 0 ${pi}"/>
	</joint>

	<!-- Gz Sim sensor (Jazzy): ray/lidar publishez via ros_gz_bridge.
	     Use gz sensor system; bridge handles LaserScan topic -->
	<gazebo reference="lidar_link">
	    	<material>Gazebo/Black</material>
		<sensor name="lidar" type="lidar">
			<always_on>true</always_on>
			<visualize>true</visualize>
			<update_rate>5</update_rate>
			<lidar>
				<scan>
					<horizontal>
						<samples>360</samples>
						<resolution>1</resolution>
						<min_angle>-3.14159</min_angle>
						<max_angle>3.14159</max_angle>
					</horizontal>
				</scan>
				<range>
					<min>0.05</min>
					<max>12</max>
					<resolution>0.01</resolution>
				</range>
				<noise>
					<type>gaussian</type>
					<mean>0.0</mean>
					<stddev>0.01</stddev>
				</noise>
			</lidar>
		</sensor>
	</gazebo>
</robot>
